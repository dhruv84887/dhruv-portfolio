# ============================================================
#  ENVIRONMENT VARIABLES — TEMPLATE
# ============================================================
#  The contact form is delivered through EmailJS and needs the
#  three values below. Copy this file to `.env` and paste your
#  real EmailJS Public Key:
#
#      cp .env.example .env      (macOS / Linux / Git Bash)
#      copy .env.example .env    (Windows PowerShell / CMD)
#
#  NEVER commit a real .env file — it is ignored by .gitignore.
#  ------------------------------------------------------------


# EmailJS service, template and PUBLIC key.
# The public key is designed to be visible in the browser.
VITE_EMAILJS_SERVICE_ID=service_g21hfmk
VITE_EMAILJS_TEMPLATE_ID=template_bfgjqi8
VITE_EMAILJS_PUBLIC_KEY=PASTE_MY_EMAILJS_PUBLIC_KEY_HERE


# Note for maintainers:
#   * Only variables prefixed with VITE_ are exposed to the client
#     bundle by Vite, and they are therefore PUBLIC — never put a
#     secret, private API key or password in a VITE_* variable.
#   * Never use the Gmail password or an EmailJS private key here.
#     Authentication happens entirely inside EmailJS; the site only
#     sends with the public key.
#   * The recipient ("To Email") is configured on the EmailJS
#     template itself, so your Gmail address stays out of the code.
#   * Read in src/config/emailjs.js — nothing else reads these.
#   * While the values above are missing or still the placeholder,
#     the contact form falls back to demo mode (nothing is sent).